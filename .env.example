# PostgreSQL connection string
# Example (local): postgresql://postgres:postgres@localhost:5432/hostel_manager?schema=public
# Example (managed, e.g. RDS/Supabase/Neon): use the connection string they give you
DATABASE_URL="postgresql://user:password@localhost:5432/hostel_manager?schema=public"

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Where tenant ID/passport uploads are stored on disk — must be outside the public/ and
# .next/ directories so files are never served statically. Defaults to ./uploads if unset.
# Point this at a dedicated volume/disk in production (and back it up).
UPLOAD_DIR="./uploads"

# Secret required to call /api/cron/reconcile (the auto-cancellation job). Generate one with:
# openssl rand -hex 24
CRON_SECRET="replace-with-a-random-secret"
